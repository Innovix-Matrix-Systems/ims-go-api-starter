---
// Starlight's splash hero, with the animated architecture diagram in place of
// a picture. Pages that set `hero.image` keep Starlight's own hero.
import Default from '@astrojs/starlight/components/Hero.astro'
import { LinkButton } from '@astrojs/starlight/components'
import Architecture from './Architecture.astro'

const { data } = Astro.locals.starlightRoute.entry
const hero = data.hero
const { title = data.title, tagline, actions = [] } = hero || {}
---

{
  hero?.image ? (
    <Default {...Astro.props} />
  ) : (
    <div class="hero">
      <div class="visual">
        <Architecture />
      </div>
      <div class="sl-flex stack">
        <div class="sl-flex copy">
          <h1 id="_top" data-page-title set:html={title} />
          {tagline && <div class="tagline" set:html={tagline} />}
        </div>
        {actions.length > 0 && (
          <div class="sl-flex actions">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton href={href} variant={variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}

<style>
  /* Mirrors Starlight's hero layout (components/Hero.astro). */
  .hero {
    display: grid;
    grid-template-columns: 100%;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 1rem;
  }
  .visual {
    width: min(100%, 26rem);
    margin-inline: auto;
  }
  .stack {
    flex-direction: column;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    text-align: center;
  }
  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .copy > * {
    max-width: 50ch;
  }
  h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }
  .actions {
    gap: 1rem 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 7fr 5fr;
      gap: 3%;
      padding-block: clamp(2.5rem, calc(1rem + 8vmin), 8rem);
    }
    .visual {
      order: 2;
      width: 100%;
    }
    .stack {
      text-align: start;
    }
    .copy {
      align-items: flex-start;
    }
    .actions {
      justify-content: flex-start;
    }
  }
</style>
